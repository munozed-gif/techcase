# /etc/techcase/sap-mcp.env
# chmod 600 — readable only by root and the techcase service user
# Never commit real values. Store in AWS Secrets Manager and inject at deploy time.

# SAP system the MCP server connects to
SAP_HOST=<sap-internal-hostname-or-ip>
SAP_PORT=44300

# VPN watchdog uses SAP_HOST + SAP_PORT to check reachability
# (same values, referenced by both services via this file)

# MCP server port (exposed only on localhost or private network — not 0.0.0.0)
PORT=8080

# Optional: restrict MCP access to Tailscale/WireGuard IP of the TechCase backend
# ALLOWED_ORIGINS=http://100.x.x.x:3000
