# .env is OPTIONAL — the bridge reads SAP credentials from the
# Authorization header sent by the techcase app (project SAP settings).
# Only set these if you want a fallback / want to test without the app.

# SAP_URL=https://your-sap-host:44300
# SAP_USER=BWDEVELOPER
# SAP_PASSWORD=yourpassword
# SAP_CLIENT=100
SAP_LANGUAGE=EN

# Port for the HTTP bridge (default: 3101)
PORT=3101
