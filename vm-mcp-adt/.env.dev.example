# DEV instance credentials — used by start-vm-dev.sh (port 3102)
# Copy this file to .env.dev and fill in your dev Supabase values.
# This NEVER touches production Supabase.

SUPABASE_URL=https://<dev-project>.supabase.co
SUPABASE_SERVICE_KEY=<dev service role key>

# Optional — SAP host for CA cert extraction (shared with prod)
# SAP_HOST=vhxaads4ci.sap.admosa.com:44300
