#!/bin/bash
# arena-netns — per-project VPN network namespaces for the ADT bridge.
#
# Installed by setup-netns.sh as /usr/local/sbin/arena-netns (root:root 0755) with a sudoers
# rule that lets the bridge user run only this script. Each SAP VPN profile gets its own
# network namespace "arena-<id>" with:
#   - a veth link to the VM (10.231.<idx>.1 on the VM, 10.231.<idx>.2 inside) and NAT, so the
#     VPN client inside can reach its gateway on the internet;
#   - the VPN client (openfortivpn / openconnect / openvpn / wireguard), whose routes and DNS
#     stay inside the namespace — a customer VPN can't change the VM's own routing;
#   - a SOCKS proxy (microsocks) on 10.231.<idx>.2:1080 for the bridge's direct SAP requests.
# The bridge also starts that project's SAP connection processes inside the namespace (exec).
#
# Usage (as the bridge user, via sudo -n):
#   arena-netns up <ns> <idx>          create the namespace and its link
#   arena-netns vpn-start <ns>         start the VPN from /var/lib/arena-netns/<ns>/ files
#   arena-netns vpn-stop <ns>
#   arena-netns socks <ns> <idx>       start the SOCKS proxy (as the calling user)
#   arena-netns status <ns>            print the VPN interface and address, exit 1 if down
#   arena-netns log <ns>               last lines of the VPN client log
#   arena-netns dns <ns>               use the VPN's DNS servers inside the namespace
#   arena-netns exec <ns> <cmd...>     run a command inside, as the calling user, keeping its env
#   arena-netns down <ns> <idx>        stop everything inside and remove the namespace
#   arena-netns list                   "<ns> <idx>" for every arena namespace
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

BASE=/var/lib/arena-netns
die() { echo "arena-netns: $*" >&2; exit 2; }
check_ns()  { [[ "${1:-}" =~ ^arena-[a-z0-9]{1,10}$ ]] || die "invalid namespace '${1:-}'"; }
check_idx() { [[ "${1:-}" =~ ^[0-9]{1,3}$ ]] && (( $1 >= 1 && $1 <= 250 )) || die "invalid index '${1:-}'"; }
caller_uid() { echo "${SUDO_UID:-$(id -u)}"; }
caller_gid() { echo "${SUDO_GID:-$(id -g)}"; }
as_caller() { setpriv --reuid="$(caller_uid)" --regid="$(caller_gid)" --init-groups -- "$@"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  up)
    ns="$1"; idx="$2"; check_ns "$ns"; check_idx "$idx"
    dir="$BASE/$ns"; mkdir -p "$dir"; chown "$(caller_uid):$(caller_gid)" "$dir"; chmod 700 "$dir"
    ip netns list | awk '{print $1}' | grep -qx "$ns" || ip netns add "$ns"
    if ! ip link show "vh$idx" >/dev/null 2>&1; then
      ip link add "vh$idx" type veth peer name "vn$idx"
      ip link set "vn$idx" netns "$ns"
      ip addr add "10.231.$idx.1/30" dev "vh$idx"
      ip link set "vh$idx" up
      ip netns exec "$ns" ip addr add "10.231.$idx.2/30" dev "vn$idx"
      ip netns exec "$ns" ip link set "vn$idx" up
      ip netns exec "$ns" ip link set lo up
      ip netns exec "$ns" ip route replace default via "10.231.$idx.1"
    fi
    sysctl -qw net.ipv4.ip_forward=1
    iptables -t nat -C POSTROUTING -s 10.231.0.0/16 ! -d 10.231.0.0/16 -j MASQUERADE 2>/dev/null \
      || iptables -t nat -A POSTROUTING -s 10.231.0.0/16 ! -d 10.231.0.0/16 -j MASQUERADE
    iptables -C FORWARD -s 10.231.0.0/16 -j ACCEPT 2>/dev/null || iptables -I FORWARD -s 10.231.0.0/16 -j ACCEPT
    iptables -C FORWARD -d 10.231.0.0/16 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
      || iptables -I FORWARD -d 10.231.0.0/16 -m state --state RELATED,ESTABLISHED -j ACCEPT
    mkdir -p "/etc/netns/$ns"
    [ -s "/etc/netns/$ns/resolv.conf" ] || printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > "/etc/netns/$ns/resolv.conf"
    echo "$idx" > "$dir/index"
    echo "up $ns $idx"
    ;;

  vpn-start)
    ns="$1"; check_ns "$ns"; dir="$BASE/$ns"; [ -d "$dir" ] || die "run 'up' first"
    type="$(cat "$dir/type" 2>/dev/null || true)"
    : > "$dir/vpn.log"; chmod 600 "$dir/vpn.log"
    case "$type" in
      fortinet)
        # Config written by the bridge (host, port, username, password, trusted-cert): no
        # free-form directives, so nothing in it can run commands.
        # DNS: never through openfortivpn/pppd — on Ubuntu that reaches the VM's systemd-resolved
        # (the whole VM would use the customer's DNS). 'dns' writes it into the namespace only.
        setsid -f ip netns exec "$ns" openfortivpn -c "$dir/forti.conf" --set-dns=0 --pppd-use-peerdns=0 \
          >>"$dir/vpn.log" 2>&1
        ;;
      anyconnect|globalprotect|pulse)
        proto="$type"; [ "$type" = "globalprotect" ] && proto="gp"; [ "$type" = "pulse" ] && proto="pulse"
        args=(--protocol="$proto" --non-inter --background --pid-file="$dir/vpn.pid" --passwd-on-stdin
              --script=/usr/local/sbin/arena-vpnc-script)
        [ -s "$dir/user" ]       && args+=(--user="$(cat "$dir/user")")
        [ -s "$dir/servercert" ] && args+=(--servercert="$(cat "$dir/servercert")")
        [ -s "$dir/authgroup" ]  && args+=(--authgroup="$(cat "$dir/authgroup")")
        ip netns exec "$ns" openconnect "${args[@]}" "$(cat "$dir/gateway")" < "$dir/pass" >>"$dir/vpn.log" 2>&1
        ;;
      openvpn)
        # Drop directives that would run commands as root on the VM.
        grep -viE '^\s*(up|down|route-up|route-pre-down|ipchange|client-connect|client-disconnect|learn-address|auth-user-pass-verify|tls-verify|plugin|script-security)\b' \
          "$dir/openvpn.conf" > "$dir/openvpn.safe.conf"
        args=(--config "$dir/openvpn.safe.conf" --script-security 1 --daemon --writepid "$dir/vpn.pid" --log-append "$dir/vpn.log")
        [ -s "$dir/auth" ] && args+=(--auth-user-pass "$dir/auth")
        ip netns exec "$ns" openvpn "${args[@]}"
        ;;
      wireguard)
        # wg-quick runs PreUp/PostUp/... as root: drop them. DNS is written into the namespace only.
        grep -iE '^\s*DNS\s*=' "$dir/wg.conf" | sed 's/^[^=]*=//' | tr ',' ' ' >> "$dir/dns" || true
        grep -viE '^\s*(PreUp|PostUp|PreDown|PostDown|SaveConfig|DNS)\s*=' "$dir/wg.conf" > "$dir/wga.conf"
        chmod 600 "$dir/wga.conf"
        ip netns exec "$ns" wg-quick up "$dir/wga.conf" >>"$dir/vpn.log" 2>&1
        ;;
      *) die "unknown VPN type '$type'" ;;
    esac
    echo "started $type"
    ;;

  vpn-stop)
    ns="$1"; check_ns "$ns"; dir="$BASE/$ns"
    type="$(cat "$dir/type" 2>/dev/null || true)"
    if [ "$type" = "wireguard" ] && [ -f "$dir/wga.conf" ]; then ip netns exec "$ns" wg-quick down "$dir/wga.conf" >/dev/null 2>&1 || true; fi
    for p in $(ip netns pids "$ns" 2>/dev/null); do
      comm="$(cat "/proc/$p/comm" 2>/dev/null || true)"
      case "$comm" in openfortivpn|pppd|openconnect|openvpn) kill "$p" 2>/dev/null || true ;; esac
    done
    echo "stopped"
    ;;

  socks)
    ns="$1"; idx="$2"; check_ns "$ns"; check_idx "$idx"
    if ! ip netns exec "$ns" ss -ltn 2>/dev/null | grep -q "10.231.$idx.2:1080"; then
      setsid -f ip netns exec "$ns" setpriv --reuid="$(caller_uid)" --regid="$(caller_gid)" --init-groups -- \
        microsocks -i "10.231.$idx.2" -p 1080 >/dev/null 2>&1
    fi
    echo "socks 10.231.$idx.2:1080"
    ;;

  dns)
    # The VPN's DNS servers, for this namespace only (/etc/netns/<ns>/resolv.conf), then a public
    # resolver as fallback. Sources: openfortivpn log, OpenVPN pushed options, WireGuard config.
    ns="$1"; check_ns "$ns"; dir="$BASE/$ns"
    servers="$( { cat "$dir/dns" 2>/dev/null | tr ' ' '\n';
                  grep -oE '(primary|secondary) +DNS address +[0-9.]+' "$dir/vpn.log" 2>/dev/null | awk '{print $NF}';
                  grep -oE 'dhcp-option +DNS +[0-9.]+' "$dir/vpn.log" 2>/dev/null | awk '{print $NF}'; } | grep -E '^[0-9.]+$' | awk '!seen[$0]++' | head -2 || true)"
    if [ -n "$servers" ]; then
      { for d in $servers; do echo "nameserver $d"; done; echo "nameserver 1.1.1.1"; } > "/etc/netns/$ns/resolv.conf"
    fi
    echo "dns ${servers//$'\n'/ }"
    ;;

  log)
    # Last lines of the VPN client log (the file is root-only; secrets are never written to it).
    ns="$1"; check_ns "$ns"; tail -n 40 "$BASE/$ns/vpn.log" 2>/dev/null || true
    ;;

  status)
    ns="$1"; check_ns "$ns"
    # No early 'exit' in awk: with pipefail + set -e, ip would die of SIGPIPE and fail the check.
    out="$(ip netns exec "$ns" ip -o -4 addr show 2>/dev/null || true)"
    line="$(printf '%s\n' "$out" | awk '$2 ~ /^(ppp|tun|wg|vpn)/ && !f {print $2, $4; f=1}')"
    [ -n "$line" ] && { echo "$line"; exit 0; }
    exit 1
    ;;

  exec)
    ns="$1"; shift; check_ns "$ns"; [ "$#" -ge 1 ] || die "missing command"
    exec ip netns exec "$ns" setpriv --reuid="$(caller_uid)" --regid="$(caller_gid)" --init-groups -- "$@"
    ;;

  down)
    ns="$1"; idx="$2"; check_ns "$ns"; check_idx "$idx"
    "$0" vpn-stop "$ns" >/dev/null 2>&1 || true
    for p in $(ip netns pids "$ns" 2>/dev/null); do kill "$p" 2>/dev/null || true; done
    sleep 1
    for p in $(ip netns pids "$ns" 2>/dev/null); do kill -9 "$p" 2>/dev/null || true; done
    ip link del "vh$idx" 2>/dev/null || true
    ip netns del "$ns" 2>/dev/null || true
    rm -rf "/etc/netns/$ns"
    rm -f "$BASE/$ns/index"
    echo "down $ns"
    ;;

  list)
    for ns in $(ip netns list 2>/dev/null | awk '{print $1}' | grep '^arena-' || true); do
      echo "$ns $(cat "$BASE/$ns/index" 2>/dev/null || echo 0)"
    done
    ;;

  *) die "usage: arena-netns up|vpn-start|vpn-stop|socks|status|dns|log|exec|down|list" ;;
esac
