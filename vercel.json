{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/claude.js":           { "maxDuration": 60 },
    "api/stripe-checkout.js":  { "maxDuration": 10 },
    "api/stripe-webhook.js":   { "maxDuration": 10 },
    "api/stripe-setup.js":     { "maxDuration": 30 },
    "api/sap-proxy.js":        { "maxDuration": 30 },
    "api/adt-write.js":        { "maxDuration": 60 },
    "api/mcp-script.js":       { "maxDuration": 10, "includeFiles": "sap-mcp-server/index.js" }
  }
}
